# ==========================================
# HistoCrypt Environment Variables (TEMPLATE)
# Copy to .env and fill in real values.
# This file is committed. .env is NOT.
# ==========================================

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=histocrypt_db
POSTGRES_USER=histocrypt_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Third-Party APIs ---
ZENQUOTES_API_KEY=

# --- CORS / CSRF (development) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173